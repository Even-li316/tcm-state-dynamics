{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Even-li316/tcm-state-dynamics/schema/case_record.schema.json",
  "title": "De-identified TCM case record (schema v1.0)",
  "description": "One treated episode: syndrome -> intervention -> observed course. Contribute only de-identified data or published cases with a citation.",
  "type": "object",
  "required": ["schema_version", "syndrome", "formula", "outcome"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "source": {
      "type": "object",
      "properties": {
        "type": { "enum": ["published", "clinical", "teaching"] },
        "citation": { "type": "string", "description": "Required when type=published" },
        "consent_basis": { "type": "string", "description": "e.g. retrospective, anonymised at source, ethics waiver ref" }
      }
    },
    "demographics": {
      "type": "object",
      "description": "Bands only. Exact age, dates, and location are not accepted.",
      "properties": {
        "age_band": { "enum": ["0-17", "18-39", "40-64", "65+"] },
        "sex": { "enum": ["F", "M", "other_or_undisclosed"] }
      }
    },
    "four_diagnostics": {
      "type": "object",
      "description": "Free text, as recorded. Keep the original wording; do not translate into modern terms.",
      "properties": {
        "inspection": { "type": "string" },
        "listening_smelling": { "type": "string" },
        "inquiry": { "type": "string" },
        "palpation": { "type": "string" }
      }
    },
    "syndrome": {
      "type": "object",
      "required": ["primary"],
      "properties": {
        "primary": { "type": "string", "description": "e.g. 风寒表实" },
        "secondary": { "type": "array", "items": { "type": "string" } },
        "six_qi": {
          "type": "array",
          "description": "Which axes the contributor believes are involved, and in which direction",
          "items": {
            "type": "object",
            "required": ["axis", "direction"],
            "properties": {
              "axis": { "enum": ["wind", "cold", "summerheat", "damp", "dryness", "fire"] },
              "direction": { "enum": ["excess", "deficiency"] },
              "severity": { "type": "number", "minimum": 0, "maximum": 3 }
            }
          }
        }
      }
    },
    "formula": {
      "type": "object",
      "required": ["herbs"],
      "properties": {
        "name": { "type": "string" },
        "herbs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["herb", "role"],
            "properties": {
              "herb": { "type": "string", "description": "Chinese name as written in the source" },
              "pinyin": { "type": "string" },
              "role": { "enum": ["jun", "chen", "zuo", "shi", "unspecified"] },
              "dose_g": { "type": "number", "exclusiveMinimum": 0 },
              "note": { "type": "string" }
            }
          }
        },
        "dosage_form": { "enum": ["decoction", "powder", "pill", "paste", "pellet", "other", "unspecified"] },
        "doses": { "type": "integer", "minimum": 1 },
        "schedule": { "type": "string", "description": "e.g. one dose daily, warm taken on empty stomach" }
      }
    },
    "external_therapy": {
      "type": "array",
      "description": "External interventions applied in the same episode (see external_therapy.schema.json)",
      "items": { "type": "object" }
    },
    "outcome": {
      "type": "object",
      "required": ["resolution"],
      "properties": {
        "resolution": { "enum": ["resolved", "improved", "persisting", "worsened", "unknown"] },
        "visits_to_resolution": { "type": "integer", "minimum": 0 },
        "follow_up_days": { "type": "integer", "minimum": 0 },
        "note": { "type": "string" }
      }
    },
    "contributor_confidence": { "enum": ["high", "medium", "low"], "description": "How confident are you that the record as transcribed is faithful" }
  },
  "additionalProperties": false
}
